Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^(admin\.n1foto\.com|admin-n1foto-test|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ - [F]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<FilesMatch "^(\.ht|composer\.|package\.|webpack\.|vite\.)">
  Require all denied
</FilesMatch>
